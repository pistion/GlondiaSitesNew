// Root-level Prisma schema for the Express server (deployed on Render).
// Provider: SQLite — database lives at /var/glondia/data/glondia.db on the persistent disk.
// JSON fields are stored as TEXT strings; routes handle JSON.stringify / JSON.parse.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Identity (auth) ──────────────────────────────────────────────────────────

model User {
  id                       String    @id @default(uuid())
  // Human-friendly customer reference (glondiac-XXXX), assigned at signup and
  // backfilled on first sign-in for older accounts.
  clientId                 String?   @unique @map("client_id")
  // IP address recorded when the account was created / client ID assigned.
  signupIp                 String?   @map("signup_ip")
  email                    String    @unique
  passwordHash             String    @map("password_hash")
  name                     String?
  role                     String    @default("owner")
  planId                   String    @default("free") @map("plan_id")
  // Profile + identity (managed by the customer and admins).
  phone                    String?
  profileDetails           String    @default("{}") @map("profile_details") // JSON as TEXT
  // idPhotoPath = private ID verification document (admin/owner only).
  // avatarPath  = profile headshot/avatar shown in the UI.
  idPhotoPath              String?   @map("id_photo_path")
  avatarPath               String?   @map("avatar_path")
  // Account lifecycle: active | suspended | disabled | deleted. Users are never
  // hard-deleted — payment/deployment history must survive a soft delete.
  accountStatus            String    @default("active") @map("account_status")
  disabledAt               DateTime? @map("disabled_at")
  disabledReason           String?   @map("disabled_reason")
  deletedAt                DateTime? @map("deleted_at")
  reactivatedAt            DateTime? @map("reactivated_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  refreshTokens   RefreshToken[]
  projects        ClientProject[]
  builderProjects BuilderProject[]
  emailMailboxes  EmailMailbox[]
  emailTransportSettings EmailTransportSetting[]
  mailFolders     MailFolder[]
  mailMessages    MailMessage[]

  @@index([accountStatus])
  @@index([createdAt])
  @@map("users")
}

// ─── Canonical Site Builder lifecycle ────────────────────────────────────────

model BuilderProject {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  clientProjectId      String?   @map("client_project_id")
  sourceType           String    @map("source_type") // template | github | zip
  templateId           String?   @map("template_id")
  templateVersion      String?   @map("template_version")
  templateSourceCommit String?   @map("template_source_commit")
  templateManifestHash String?   @map("template_manifest_hash")
  name                 String
  slug                 String
  status               String    @default("DRAFT")
  version              Int       @default(1)
  currentRevisionId    String?   @map("current_revision_id")
  approvedRevisionId   String?   @map("approved_revision_id")
  planJson             String    @default("{}") @map("plan_json")
  answerSheetJson      String    @default("{}") @map("answer_sheet_json")
  metadata             String    @default("{}")
  archivedAt           DateTime? @map("archived_at")
  deletedAt            DateTime? @map("deleted_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user             User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  revisions        BuilderRevision[]
  jobs             BuilderJob[]
  previewGrants    BuilderPreviewGrant[]
  deploymentLinks  BuilderDeploymentLink[]
  stateTransitions BuilderStateTransition[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([clientProjectId])
  @@index([templateId, templateVersion])
  @@index([updatedAt])
  @@map("builder_projects")
}

model BuilderRevision {
  id                  String    @id @default(uuid())
  projectId           String    @map("project_id")
  revisionNumber      Int       @map("revision_number")
  parentRevisionId    String?   @map("parent_revision_id")
  status              String    @default("DRAFT")
  planSnapshotJson    String    @default("{}") @map("plan_snapshot_json")
  answerSheetJson     String    @default("{}") @map("answer_sheet_json")
  generatedSiteJson   String    @default("{}") @map("generated_site_json")
  artifactLocation    String?   @map("artifact_location")
  artifactChecksum    String?   @map("artifact_checksum")
  sourceCommit        String?   @map("source_commit")
  generationModel     String?   @map("generation_model")
  generationUsageJson String    @default("{}") @map("generation_usage_json")
  validationJson      String    @default("{}") @map("validation_json")
  changeRequestJson   String    @default("{}") @map("change_request_json")
  createdByUserId     String?   @map("created_by_user_id")
  approvedByUserId    String?   @map("approved_by_user_id")
  approvedAt          DateTime? @map("approved_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  project         BuilderProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs            BuilderJob[]
  previewGrants   BuilderPreviewGrant[]
  deploymentLinks BuilderDeploymentLink[]

  @@unique([projectId, revisionNumber])
  @@index([projectId, status])
  @@index([artifactChecksum])
  @@map("builder_revisions")
}

model BuilderJob {
  id             String    @id @default(uuid())
  projectId      String    @map("project_id")
  revisionId     String?   @map("revision_id")
  jobType        String    @map("job_type")
  status         String    @default("QUEUED")
  stage          String?
  idempotencyKey String    @unique @map("idempotency_key")
  requestHash    String?   @map("request_hash")
  payloadJson    String    @default("{}") @map("payload_json")
  resultJson     String    @default("{}") @map("result_json")
  progressJson   String    @default("{}") @map("progress_json")
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")
  attempt        Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  availableAt    DateTime  @default(now()) @map("available_at")
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  cancelledAt    DateTime? @map("cancelled_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  project  BuilderProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision BuilderRevision?  @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  events   BuilderJobEvent[]

  @@index([status, availableAt])
  @@index([leaseExpiresAt])
  @@index([projectId, createdAt])
  @@index([revisionId])
  @@map("builder_jobs")
}

model BuilderJobEvent {
  id          String   @id @default(uuid())
  jobId       String   @map("job_id")
  sequence    Int
  stage       String?
  level       String   @default("info")
  message     String
  detailsJson String   @default("{}") @map("details_json")
  createdAt   DateTime @default(now()) @map("created_at")

  job BuilderJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sequence])
  @@index([jobId, createdAt])
  @@map("builder_job_events")
}

model BuilderPreviewGrant {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  revisionId      String    @map("revision_id")
  tokenHash       String    @unique @map("token_hash")
  audience        String    @default("owner")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  lastUsedAt      DateTime? @map("last_used_at")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  project  BuilderProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision BuilderRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([projectId, expiresAt])
  @@index([revisionId])
  @@map("builder_preview_grants")
}

model BuilderDeploymentLink {
  id                  String   @id @default(uuid())
  projectId           String   @map("project_id")
  revisionId          String   @map("revision_id")
  deploymentId        String   @unique @map("deployment_id")
  idempotencyKey      String   @unique @map("idempotency_key")
  status              String   @default("QUEUED")
  isCurrent           Boolean  @default(true) @map("is_current")
  hostingDeploymentId String?  @map("hosting_deployment_id")
  renderServiceId     String?  @map("render_service_id")
  renderDeployId      String?  @map("render_deploy_id")
  liveUrl             String?  @map("live_url")
  errorMessage        String?  @map("error_message")
  metadata            String   @default("{}")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  project  BuilderProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision BuilderRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)

  @@index([projectId, isCurrent])
  @@index([revisionId])
  @@index([status])
  @@map("builder_deployment_links")
}

model BuilderStateTransition {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  fromStatus String   @map("from_status")
  toStatus   String   @map("to_status")
  actorType  String   @default("system") @map("actor_type")
  actorId    String?  @map("actor_id")
  reason     String?
  requestId  String?  @map("request_id")
  jobId      String?  @map("job_id")
  createdAt  DateTime @default(now()) @map("created_at")

  project BuilderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([jobId])
  @@map("builder_state_transitions")
}

model BuilderWorkerHeartbeat {
  workerId   String   @id @map("worker_id")
  infoJson   String   @default("{}") @map("info_json")
  startedAt  DateTime @default(now()) @map("started_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@index([lastSeenAt])
  @@map("builder_worker_heartbeats")
}

model AiUsageEvent {
  id                  String   @id @default(uuid())
  userId              String?  @map("user_id")
  projectId           String?  @map("project_id")
  jobId               String?  @map("job_id")
  provider            String
  model               String
  operation           String
  promptTokens        Int      @default(0) @map("prompt_tokens")
  completionTokens    Int      @default(0) @map("completion_tokens")
  estimatedCostMicros Int      @default(0) @map("estimated_cost_micros")
  status              String
  requestId           String?  @map("request_id")
  metadata            String   @default("{}")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([jobId])
  @@map("ai_usage_events")
}

// ─── Client Projects ─────────────────────────────────────────────────────────

model ClientProject {
  id          String    @id @default(uuid())
  projectCode String    @unique @map("project_code")
  userId      String?   @map("user_id")
  clientId    String?   @map("client_id")
  workspaceId String?   @map("workspace_id")
  name        String
  slug        String
  serviceType String    @default("website") @map("service_type") // website | hosting | domain | email | vps | consultation | build | support | other
  status      String    @default("draft") // draft | active | paused | completed | archived
  priority    String    @default("normal")
  description String?
  storageNamespace  String    @map("storage_namespace")
  autoBillingEnabled Boolean  @default(false) @map("auto_billing_enabled")
  billingAmount     Decimal   @default(0) @map("billing_amount")
  billingCurrency   String    @default("PGK") @map("billing_currency")
  billingInterval   String    @default("monthly") @map("billing_interval")
  metadata    String    @default("{}")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, slug])
  @@index([userId, serviceType])
  @@index([clientId])
  @@index([workspaceId])
  @@index([status, createdAt])
  @@map("client_projects")
}

// User-facing notifications (distinct from internal AuditLog history).
model Notification {
  id         String    @id @default(uuid())
  userId     String?   @map("user_id")
  audience   String    @default("user") // user | admin | all
  type       String    @default("info") // info | success | warning | danger | billing | deployment | account | receipt | subscription
  title      String
  message    String
  actionUrl  String?   @map("action_url")
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  metadata   String    @default("{}") // JSON as TEXT
  readAt     DateTime? @map("read_at")
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([userId, readAt])
  @@index([audience, createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── VPS Hosting (Vultr) ──────────────────────────────────────────────────────

model VpsService {
  id                 String    @id @default(uuid())
  clientProjectId    String?   @map("client_project_id")
  organizationId     String    @map("organization_id")
  createdByUserId    String?   @map("created_by_user_id")
  checkoutOrderId    String?   @map("checkout_order_id")
  provider           String    @default("vultr")
  providerInstanceId String    @map("provider_instance_id")
  label              String
  hostname           String
  region             String
  plan               String
  osId               Int       @map("os_id")
  osName             String?   @map("os_name")
  status             String    @default("pending")
  mainIp             String?   @map("main_ip")
  vcpuCount          Int?      @map("vcpu_count")
  ramMb              Int?      @map("ram_mb")
  diskGb             Int?      @map("disk_gb")
  monthlyCostCents   Int       @map("monthly_cost_cents")
  markupPercent      Float     @default(30) @map("markup_percent")
  markupAmountCents  Int       @map("markup_amount_cents")
  totalPriceCents    Int       @map("total_price_cents")
  currency           String    @default("USD")
  paypalOrderId      String?   @map("paypal_order_id")
  paypalCaptureId    String?   @map("paypal_capture_id")
  paymentStatus      String    @default("pending") @map("payment_status")
  metadata           String    @default("{}") // JSON as TEXT
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  actionLogs VpsActionLog[]

  @@index([organizationId])
  @@index([clientProjectId])
  @@index([providerInstanceId])
  @@index([paypalOrderId])
  @@index([checkoutOrderId])
  @@map("vps_services")
}

model VpsActionLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  vpsServiceId   String   @map("vps_service_id")
  actorUserId    String?  @map("actor_user_id")
  action         String
  status         String   @default("pending")
  request        String   @default("{}") // JSON as TEXT
  response       String   @default("{}") // JSON as TEXT
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at")

  vpsService VpsService @relation(fields: [vpsServiceId], references: [id], onDelete: Cascade)

  @@index([vpsServiceId])
  @@index([organizationId, createdAt])
  @@map("vps_action_logs")
}

model VpsCatalogSnapshot {
  kind          String    @id
  payload       String    @default("[]")
  syncStatus    String    @default("seeded") @map("sync_status")
  errorMessage  String?   @map("error_message")
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("vps_catalog_snapshots")
}

// Ownership map for provider-account-level resources (SSH keys, snapshots,
// backups…). The Vultr account is shared across all customers, so every
// resource a customer creates is recorded here and list/delete/restore are
// scoped to the owning organization.
model ProviderResource {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  userId             String?   @map("user_id")
  serviceId          String?   @map("service_id")
  provider           String    @default("vultr")
  resourceType       String    @map("resource_type") // instance | ssh_key | snapshot | backup
  providerResourceId String    @map("provider_resource_id")
  name               String?
  status             String    @default("active")
  metadata           String    @default("{}") // JSON as TEXT
  deletedAt          DateTime? @map("deleted_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([provider, resourceType, providerResourceId])
  @@index([organizationId, resourceType])
  @@index([serviceId])
  @@map("provider_resources")
}

// ─── Web Hosting (Render-powered) ────────────────────────────────────────────

model WebHostingService {
  id                String    @id @default(uuid())
  clientProjectId   String?   @map("client_project_id")
  organizationId    String    @map("organization_id")
  createdByUserId   String?   @map("created_by_user_id")
  checkoutOrderId   String?   @map("checkout_order_id")
  provider          String    @default("render")
  providerServiceId String?   @map("provider_service_id")
  name              String
  slug              String
  serviceType       String    @default("web_service") @map("service_type")
  status            String    @default("pending")
  region            String?
  plan              String?
  url               String?
  customDomain      String?   @map("custom_domain")
  monthlyCostCents  Int       @default(0) @map("monthly_cost_cents")
  markupPercent     Float     @default(30) @map("markup_percent")
  markupAmountCents Int       @default(0) @map("markup_amount_cents")
  totalPriceCents   Int       @default(0) @map("total_price_cents")
  currency          String    @default("USD")
  billingModel      String    @default("monthly") @map("billing_model")
  paymentStatus     String    @default("pending") @map("payment_status")
  // Deploy-first billing: grace deadline + payment timestamp + why removed.
  billingDueAt      DateTime? @map("billing_due_at")
  paidAt            DateTime? @map("paid_at")
  deletedReason     String?   @map("deleted_reason")
  metadata          String    @default("{}") // JSON as TEXT
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([clientProjectId])
  @@index([providerServiceId])
  @@index([checkoutOrderId])
  @@map("web_hosting_services")
}

// ─── Business Services (domains, email hosting, SSL, etc.) ───────────────────

model CloudStorageService {
  id                    String    @id @default(uuid())
  clientProjectId       String?   @map("client_project_id")
  organizationId        String    @map("organization_id")
  createdByUserId       String?   @map("created_by_user_id")
  checkoutOrderId       String?   @map("checkout_order_id")
  name                  String
  serviceKind           String    @map("service_kind")
  tenancy               String
  planKey               String    @map("plan_key")
  planSize              String    @map("plan_size")
  region                String
  postgresVersion       String?   @map("postgres_version")
  provider              String    @default("vultr")
  providerResourceId    String?   @map("provider_resource_id")
  providerSecondaryId   String?   @map("provider_secondary_id")
  status                String    @default("pending_payment")
  provisioningStage     String    @default("intent_recorded") @map("provisioning_stage")
  syncStatus            String    @default("pending") @map("sync_status")
  adminStatus           String    @default("allowed") @map("admin_status")
  paymentStatus         String    @default("pending") @map("payment_status")
  capacityBytes         String    @default("0") @map("capacity_bytes")
  transferIncludedBytes String    @default("0") @map("transfer_included_bytes")
  storageUsedBytes      String    @default("0") @map("storage_used_bytes")
  transferUsedBytes     String    @default("0") @map("transfer_used_bytes")
  overageStorageBytes   String    @default("0") @map("overage_storage_bytes")
  overageTransferBytes  String    @default("0") @map("overage_transfer_bytes")
  monthlyCostCents      Int       @default(0) @map("monthly_cost_cents")
  markupPercent         Float     @default(30) @map("markup_percent")
  markupAmountCents     Int       @default(0) @map("markup_amount_cents")
  totalPriceCents       Int       @default(0) @map("total_price_cents")
  currency              String    @default("USD")
  deploymentBranch      String    @default("main") @map("deployment_branch")
  publicAccess          Boolean   @default(false) @map("public_access")
  corsOrigins           String    @default("[]") @map("cors_origins")
  trustedNetworks       String    @default("[]") @map("trusted_networks")
  externalAccessEnabled Boolean   @default(false) @map("external_access_enabled")
  privateNetworkAttached Boolean  @default(false) @map("private_network_attached")
  retentionDaily        Int       @default(7) @map("retention_daily")
  retentionWeekly       Int       @default(4) @map("retention_weekly")
  credentialsCiphertext String?   @map("credentials_ciphertext")
  provisioningSecretCiphertext String? @map("provisioning_secret_ciphertext")
  credentialsPreview    String?   @map("credentials_preview")
  lastSyncedAt          DateTime? @map("last_synced_at")
  paidAt                DateTime? @map("paid_at")
  activatedAt           DateTime? @map("activated_at")
  suspendedAt           DateTime? @map("suspended_at")
  deletedAt             DateTime? @map("deleted_at")
  metadata              String    @default("{}")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  actions       CloudStorageActionLog[]
  usageSamples  CloudStorageUsageSample[]
  restorePoints CloudStorageRestorePoint[]
  storedObjects CloudStorageObject[]
  repoLinks     CloudStorageRepositoryLink[]
  driveCredential CloudDriveCredential?
  driveSessions   CloudDriveSession[]

  @@index([organizationId, serviceKind])
  @@index([clientProjectId])
  @@index([createdByUserId])
  @@index([checkoutOrderId])
  @@index([providerResourceId])
  @@index([status, paymentStatus])
  @@map("cloud_storage_services")
}

model CloudDriveCredential {
  id                        String    @id @default(uuid())
  serviceId                 String    @unique @map("service_id")
  userId                    String?   @map("user_id")
  accountEmail              String    @map("account_email")
  passwordHash              String    @map("password_hash")
  initialPasswordCiphertext String?   @map("initial_password_ciphertext")
  initialPasswordViewedAt   DateTime? @map("initial_password_viewed_at")
  passwordVersion           Int       @default(1) @map("password_version")
  twoFactorEnabled          Boolean   @default(false) @map("two_factor_enabled")
  twoFactorMethod           String?   @map("two_factor_method")
  lastLoginAt               DateTime? @map("last_login_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  service CloudStorageService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cloud_drive_credentials")
}

model CloudDriveSession {
  id           String    @id @default(uuid())
  serviceId    String    @map("service_id")
  userId       String?   @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  lastUsedAt   DateTime  @default(now()) @map("last_used_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  service CloudStorageService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, expiresAt])
  @@index([userId])
  @@map("cloud_drive_sessions")
}

model CloudStorageCatalogSnapshot {
  id           String    @id @default(uuid())
  catalogKey   String    @unique @map("catalog_key")
  payload      String
  syncStatus   String    @default("seeded") @map("sync_status")
  errorMessage String?   @map("error_message")
  lastSyncedAt DateTime? @map("last_synced_at")
